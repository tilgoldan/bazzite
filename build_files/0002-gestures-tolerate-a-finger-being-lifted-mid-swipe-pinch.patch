From f9236004a9d49115d91212c01bb5e359aa1dd716 Mon Sep 17 00:00:00 2001
From: Til Goldan <til@goldan.dev>
Date: Wed, 8 Jul 2026 14:31:28 +0200
Subject: [PATCH] gestures: tolerate a finger being lifted mid-swipe/pinch

Currently any change in touch count during an active swipe or pinch
gesture (GESTURE_EVENT_FINGER_SWITCH_TIMEOUT) unconditionally cancels
it via tp_gesture_cancel(), even if the change is just one finger of
e.g. a 4-finger swipe lifting off briefly or being misdetected for a
frame. The gesture is then re-recognized from scratch with the lower
finger count, which is visible to the user as the gesture "downgrading"
mid-motion.

3fg-drag already tolerates this: it only ends the drag once fewer than
two touches remain, otherwise it keeps going. Apply the same tolerance
to swipe/pinch, and keep reporting the finger_count the gesture started
with for its remaining lifetime rather than letting it drift down,
since libinput's own gesture motion averaging (tp_get_touches_delta)
already computes deltas from whatever touches are still active.

A full liftoff (0 active touches) is unaffected and still ends the
gesture immediately, matching the existing documented behaviour that a
gesture ends once all of its fingers are lifted.

Keeping finger_count pinned above the real active touch count means
tp_gesture_update_finger_state() sees a permanent (not transient)
mismatch for as long as the lift lasts. Left alone, that re-arms the
finger-count-switch debounce and its 100ms tp_gesture_post_events()
block on every frame, so the gesture only crawls forward in short
bursts between debounce cycles instead of tracking motion continuously
-- visible to the user as the gesture getting stuck until the lifted
finger returns. Recognise the tolerated-lift case directly in
tp_gesture_update_finger_state() and skip the debounce/pending path
for it entirely so motion keeps flowing.

Stacked on top of bazzite-til's 0001-meson-build-options patch.
---
 src/evdev-mt-touchpad-gestures.c | 46 ++++++++++++++++++++++++++++++--
 1 file changed, 44 insertions(+), 2 deletions(-)

diff --git a/src/evdev-mt-touchpad-gestures.c b/src/evdev-mt-touchpad-gestures.c
index 3cce1ed9..52c1053c 100644
--- a/src/evdev-mt-touchpad-gestures.c
+++ b/src/evdev-mt-touchpad-gestures.c
@@ -45,6 +45,11 @@ enum gesture_cancelled {
 #ifndef DRAG_3FG_ALWAYS_DRAG
 #define DRAG_3FG_OR_SWIPE_MOVE_THRESHOLD 5 /* mm */
 #endif
+/* Minimum touches required to keep a swipe/pinch alive when the finger
+ * count drops mid-gesture (e.g. a finger lifts briefly or is misdetected
+ * for a frame). Below this we can no longer tell what gesture is meant,
+ * so we cancel instead of guessing. */
+#define GESTURE_MIN_FINGERS_TO_SUSTAIN 1
 
 enum gesture_event {
 	GESTURE_EVENT_RESET,
@@ -933,7 +938,17 @@ tp_gesture_handle_event_on_state_pinch(struct tp_dispatch *tp,
 		break;
 	}
 	case GESTURE_EVENT_FINGER_SWITCH_TIMEOUT:
-		tp_gesture_cancel(tp, time);
+		if (tp->gesture.finger_count_pending < GESTURE_MIN_FINGERS_TO_SUSTAIN) {
+			tp_gesture_cancel(tp, time);
+		} else {
+			/* Tolerate the finger count change: stay in this
+			 * gesture and keep reporting the finger_count it
+			 * started with (motion is still computed from
+			 * whichever touches remain active). This mirrors
+			 * the tolerance 3fg-drag already has for a finger
+			 * being lifted mid-gesture. */
+			tp->gesture.finger_count_pending = tp->gesture.finger_count;
+		}
 		break;
 	case GESTURE_EVENT_HOLD_AND_MOTION_START:
 	case GESTURE_EVENT_FINGER_DETECTED:
@@ -1002,7 +1017,17 @@ tp_gesture_handle_event_on_state_swipe(struct tp_dispatch *tp,
 		break;
 	}
 	case GESTURE_EVENT_FINGER_SWITCH_TIMEOUT:
-		tp_gesture_cancel(tp, time);
+		if (tp->gesture.finger_count_pending < GESTURE_MIN_FINGERS_TO_SUSTAIN) {
+			tp_gesture_cancel(tp, time);
+		} else {
+			/* Tolerate the finger count change: stay in this
+			 * gesture and keep reporting the finger_count it
+			 * started with (motion is still computed from
+			 * whichever touches remain active). This mirrors
+			 * the tolerance 3fg-drag already has for a finger
+			 * being lifted mid-gesture. */
+			tp->gesture.finger_count_pending = tp->gesture.finger_count;
+		}
 		break;
 	case GESTURE_EVENT_HOLD_AND_MOTION_START:
 	case GESTURE_EVENT_FINGER_DETECTED:
@@ -2227,6 +2252,23 @@ tp_gesture_update_finger_state(struct tp_dispatch *tp, usec_t time)
 			active_touches++;
 	}
 
+	/* Swipe/pinch tolerate a finger being lifted mid-gesture by keeping
+	 * finger_count pinned at its original value instead of adopting
+	 * active_touches (see the FINGER_SWITCH_TIMEOUT handling for those
+	 * states). That means active_touches can stay below finger_count for
+	 * as long as the lift lasts, which is a stable condition, not a
+	 * transient one. Recognise that here and skip it entirely instead of
+	 * re-arming the mismatch debounce every frame, which would otherwise
+	 * keep blocking tp_gesture_post_events() for repeated 100ms windows. */
+	if ((tp->gesture.state == GESTURE_STATE_SWIPE ||
+	     tp->gesture.state == GESTURE_STATE_PINCH) &&
+	    active_touches < tp->gesture.finger_count &&
+	    active_touches >= GESTURE_MIN_FINGERS_TO_SUSTAIN) {
+		tp->gesture.finger_count_pending = 0;
+		libinput_timer_cancel(&tp->gesture.finger_count_switch_timer);
+		return;
+	}
+
 	if (active_touches != tp->gesture.finger_count) {
 		/* If all fingers are lifted immediately end the gesture */
 		if (active_touches == 0) {
-- 
2.53.0

